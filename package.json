  "scripts": {
    "build": "bunx --bun nest build",
    "format": "bunx --bun prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bunx --bun nest start",
    "start:dev": "bunx --bun nest start --watch",
    "start:debug": "bunx --bun nest start --debug --watch",
    "start:prod": "bun run --bun dist/main",
    "lint": "bunx bun eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bunx --bun jest",
    "test:watch": "bunx --bun jest --watch",
    "test:cov": "bunx --bun jest --coverage",
    "test:debug": "bunx --bun node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "bunx --bun jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@knaadh/nestjs-drizzle-mysql2": "^1.2.0",
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@node-rs/argon2": "^2.0.2",
    "@types/express-session": "^1.18.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "drizzle-kit": "^0.27.2",
    "drizzle-orm": "^0.36.4",
    "express": "^4.22.1",
    "express-session": "^1.18.2",
    "mysql2": "^3.16.0",
    "nanoid": "^5.1.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.8",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.27",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.16",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
